{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra-model.invalid/schema/v0alpha1/network.json",
  "title": "Network",
  "type": "object",
  "properties": {
    "apiVersion": {
      "const": "infra.model/v0alpha1"
    },
    "kind": {
      "const": "Network"
    },
    "metadata": {
      "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/metadata"
    },
    "spec": {
      "type": "object",
      "properties": {
        "siteRefs": {
          "type": "array",
          "description": "Optional allowed site scope. Omission is unconstrained; listed sites need not be occupied. Authored order is preserved but has no semantic significance.",
          "items": {
            "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/siteRef"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "layer": {
          "enum": [
            "layer2",
            "layer3"
          ]
        },
        "connectivity": {
          "description": "Omission means multipoint (a shared connectivity domain). Point-to-point permits at most two logical endpoints, counted as NetworkAttachments regardless of address count.",
          "enum": [
            "multipoint",
            "point-to-point"
          ]
        },
        "prefixes": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ip-prefix",
            "pattern": "^[^/]+/(?:0|[1-9][0-9]*)$(?![\\s\\S])"
          },
          "uniqueItems": true
        },
        "defaultGateways": {
          "type": "array",
          "description": "One default gateway per declared prefix; omission is unspecified and an empty list explicitly means no default gateway.",
          "items": {
            "type": "object",
            "properties": {
              "prefix": {
                "type": "string",
                "format": "ip-prefix",
                "pattern": "^[^/]+/(?:0|[1-9][0-9]*)$(?![\\s\\S])"
              },
              "address": {
                "type": "string",
                "format": "ip-address"
              }
            },
            "required": [
              "prefix",
              "address"
            ],
            "additionalProperties": false
          }
        },
        "dns": {
          "type": "object",
          "description": "Shared DNS configuration; omission is unspecified and an empty servers list explicitly means no DNS servers.",
          "properties": {
            "servers": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "ip-address"
              },
              "uniqueItems": true
            }
          },
          "required": [
            "servers"
          ],
          "additionalProperties": false
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "status": {
      "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/status"
    },
    "extensions": {
      "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
