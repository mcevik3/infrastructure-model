{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://infra-model.invalid/schema/v0alpha1/common.json",
  "title": "v0alpha1 common types",
  "$defs": {
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
      },
      "additionalProperties": true
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "siteRef": {
      "type": "string",
      "pattern": "^site/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "profileRef": {
      "type": "string",
      "pattern": "^hardware-profile/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "networkRef": {
      "type": "string",
      "pattern": "^network/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "resourceRef": {
      "type": "string",
      "pattern": "^server/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "interfaceRef": {
      "type": "string",
      "pattern": "^(server/[A-Za-z0-9][A-Za-z0-9._-]*/network-adapter/[A-Za-z0-9][A-Za-z0-9._-]*|network-device/[A-Za-z0-9][A-Za-z0-9._-]*)/interface/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "byteQuantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "B",
            "kB",
            "MB",
            "GB",
            "TB",
            "KiB",
            "MiB",
            "GiB",
            "TiB"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "frequencyQuantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "Hz",
            "kHz",
            "MHz",
            "GHz"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "bandwidthQuantity": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "bps",
            "Kbps",
            "Mbps",
            "Gbps",
            "Tbps"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false
    },
    "compute": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/frequencyQuantity"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "cpu": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/cpu"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Physical inventory capabilities, with CPU topology under cpu."
    },
    "memory": {
      "type": "object",
      "properties": {
        "capacity": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/byteQuantity"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [
        "capacity"
      ],
      "additionalProperties": false
    },
    "storage": {
      "type": "object",
      "properties": {
        "capacity": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/byteQuantity"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "medium": {
          "enum": [
            "hdd",
            "ssd",
            "other"
          ]
        },
        "protocol": {
          "enum": [
            "nvme",
            "sata",
            "sas",
            "scsi",
            "virtio",
            "other"
          ]
        }
      },
      "required": [
        "capacity"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "nodeTypes": {
          "type": "array",
          "items": {
            "enum": [
              "baremetal",
              "vm"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "compute": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/compute"
        },
        "memory": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/memory"
        },
        "storage": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/storage"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "requirements": {
      "type": "object",
      "properties": {
        "compute": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/computeRequirements"
        },
        "memory": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/memory"
        },
        "storage": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/storage"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "devices": {
          "type": "array",
          "items": {
            "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/deviceRequirement"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "interface": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "macAddress": {
          "type": "string",
          "pattern": "^(?:[0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$(?![\\s\\S])"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "bandwidth": {
              "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/bandwidthQuantity"
            },
            "extensions": {
              "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
            },
            "features": {
              "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/featureList"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "status": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/status"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "type": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/interfaceType"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "networkAdapter": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "pciAddress": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/pciAddress"
        },
        "interfaces": {
          "type": "array",
          "items": {
            "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/interface"
          },
          "minItems": 1
        },
        "status": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/status"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "class": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/adapterClass"
        },
        "features": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/featureList"
        }
      },
      "required": [
        "name",
        "interfaces"
      ],
      "additionalProperties": false
    },
    "accelerator": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "type": {
          "enum": [
            "gpu",
            "fpga",
            "other"
          ]
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "pciAddress": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/pciAddress"
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "features": {
              "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/featureList"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "pciAddress": {
      "type": "string",
      "pattern": "^(?:[0-9A-Fa-f]{4}:)?[0-9A-Fa-f]{2}:[01][0-9A-Fa-f]\\.[0-7]$(?![\\s\\S])"
    },
    "storageDevice": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "pciAddress": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/pciAddress"
        },
        "capacity": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/byteQuantity"
        },
        "status": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/status"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "medium": {
          "enum": [
            "hdd",
            "ssd",
            "other"
          ]
        },
        "protocol": {
          "enum": [
            "nvme",
            "sata",
            "sas",
            "scsi",
            "virtio",
            "other"
          ]
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "serial": {
          "type": "string",
          "minLength": 1
        },
        "controllerRef": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/controllerRef"
        },
        "location": {
          "type": "object",
          "properties": {
            "bay": {
              "type": "integer",
              "minimum": 0
            },
            "extensions": {
              "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "features": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/featureList"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "networkAttachment": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "networkRef": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/networkRef"
        },
        "addresses": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "ip-address"
          },
          "uniqueItems": true
        },
        "status": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/status"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "interfaceRequirements": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/interfaceRequirements"
        }
      },
      "required": [
        "name",
        "networkRef"
      ],
      "additionalProperties": false
    },
    "clusterNode": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/name"
        },
        "requirements": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/requirements"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "image": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/image"
        },
        "networkAttachments": {
          "type": "array",
          "items": {
            "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/networkAttachment"
          }
        },
        "status": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/status"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "realization": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/realization"
        },
        "placement": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/placement"
        },
        "configuration": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/configuration"
        }
      },
      "required": [
        "name",
        "realization"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "realization": {
                "properties": {
                  "type": {
                    "const": "vm"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "placement": {
                "not": {
                  "required": [
                    "resourceRef"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "cpuRequirement": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "unit": {
          "enum": [
            "vcpu",
            "core",
            "thread"
          ]
        }
      },
      "required": [
        "count",
        "unit"
      ],
      "additionalProperties": false,
      "description": "Guest virtual CPU, physical-core, or hardware-thread demand. Physical core counts do not prove vCPU capacity."
    },
    "computeRequirements": {
      "type": "object",
      "properties": {
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/frequencyQuantity"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "cpu": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/cpuRequirement"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "availability": {
          "type": "string",
          "minLength": 1
        },
        "operationalState": {
          "type": "string",
          "minLength": 1
        },
        "powerState": {
          "type": "string",
          "minLength": 1
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false,
      "description": "Generic observations only; provider-specific transient/discovered state belongs under namespaced extensions. Not placement evidence."
    },
    "realization": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "baremetal",
            "vm"
          ]
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "siteRef": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/siteRef"
        },
        "resourceRef": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/resourceRef",
          "description": "Exact selection of an existing Server; supported only for baremetal realization."
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "blockDeviceRef": {
      "type": "string",
      "pattern": "^server/[A-Za-z0-9][A-Za-z0-9._-]*/storage-(?:volume|device)/[A-Za-z0-9][A-Za-z0-9._-]*$(?![\\s\\S])"
    },
    "pvSourceRef": {
      "type": "string",
      "pattern": "^(?:server/[A-Za-z0-9][A-Za-z0-9._-]*/storage-(?:volume|device)/[A-Za-z0-9][A-Za-z0-9._-]*|(?:cluster/[A-Za-z0-9][A-Za-z0-9._-]*/node/[A-Za-z0-9][A-Za-z0-9._-]*/storage/)?partition-table/[A-Za-z0-9][A-Za-z0-9._-]*/partition/[A-Za-z0-9][A-Za-z0-9._-]*)$(?![\\s\\S])"
    },
    "controllerRef": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|server/[A-Za-z0-9][A-Za-z0-9._-]*/storage-controller/[A-Za-z0-9][A-Za-z0-9._-]*)$(?![\\s\\S])"
    },
    "deviceRef": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|server/[A-Za-z0-9][A-Za-z0-9._-]*/storage-device/[A-Za-z0-9][A-Za-z0-9._-]*)$(?![\\s\\S])"
    },
    "physicalVolumeRef": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|cluster/[A-Za-z0-9][A-Za-z0-9._-]*/node/[A-Za-z0-9][A-Za-z0-9._-]*/storage/lvm/pv/[A-Za-z0-9][A-Za-z0-9._-]*)$(?![\\s\\S])"
    },
    "volumeGroupRef": {
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9][A-Za-z0-9._-]*|cluster/[A-Za-z0-9][A-Za-z0-9._-]*/node/[A-Za-z0-9][A-Za-z0-9._-]*/storage/lvm/vg/[A-Za-z0-9][A-Za-z0-9._-]*)$(?![\\s\\S])"
    },
    "cpuTopology": {
      "type": "object",
      "properties": {
        "coresPerSocket": {
          "type": "integer",
          "minimum": 1
        },
        "threadsPerCore": {
          "type": "integer",
          "minimum": 1
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cpuSmt": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "serverCpuSmt": {
      "type": "object",
      "properties": {
        "supported": {
          "type": "boolean"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "cpuNuma": {
      "type": "object",
      "properties": {
        "supportedNodesPerSocket": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "numaNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 0
        },
        "socket": {
          "type": "integer",
          "minimum": 0
        },
        "cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/memory"
        },
        "extensions": {
          "$ref": "https://infra-model.invalid/schema/v0alpha1/common.json#/$defs/extensions"
        }
      },
      "required": [
        "id",
        "socket"
      ],
      "additionalProperties": false
    },
